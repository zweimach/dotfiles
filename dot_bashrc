# ┏━━━━━━━━━━━━━━━━━━━━━━━
# ┃ History
# ┗━━━━━━━━━━━━━━━━━━━━━━━
export HISTFILE=~/.bash_history
export HISTFILESIZE=
export HISTSIZE=

# ┏━━━━━━━━━━━━━━━━━━━━━━━
# ┃ fzf & rg
# ┗━━━━━━━━━━━━━━━━━━━━━━━
export FZF_DEFAULT_OPTS='-m --height 70% --border=sharp --layout=reverse'

if type rg &>/dev/null; then
	export FZF_DEFAULT_COMMAND='rg --files --hidden'
fi

test -r /usr/share/fzf/key-bindings.bash && source /usr/share/fzf/key-bindings.bash >/dev/null 2>/dev/null || true
test -r /usr/share/fzf/completion.bash && source /usr/share/fzf/completion.bash >/dev/null 2>/dev/null || true

fzf-workspace-widget() {
	local cmd dir _dir
	dir=$(command ls -1 "$WORKSPACE" | FZF_DEFAULT_OPTS="--height ${FZF_TMUX_HEIGHT:-40%} --reverse --bind=ctrl-z:ignore $FZF_DEFAULT_OPTS" $(__fzfcmd) +m)
	_dir=${dir//[.]/_}
	case "$1" in
	'tmux')
		local switch_cmd has_session
		switch_cmd="tmux switch-client -t $_dir"
		tmux has-session -t "$_dir" >/dev/null 2>/dev/null
		has_session=$?
		if [[ "$has_session" -eq 0 ]]; then
			echo "$switch_cmd"
		else
			printf "tmux new-session -d -c %s -s %s && %s" "$WORKSPACE/$dir" "$_dir" "$switch_cmd"
		fi
		;;
	*)
		printf 'cd -- %q' "$WORKSPACE/$dir"
		;;
	esac
}

if [[ ${SHELLOPTS} =~ (vi|emacs) ]]; then
	bind -m emacs-standard '"\eo": "\C-b\C-k \C-u`fzf-workspace-widget`\e\C-e\er\C-m\C-y\C-h\e \C-y\ey\C-x\C-x\C-d"'
	bind -m vi-command '"\eo": "\C-z\eo\C-z"'
	bind -m vi-insert '"\eo": "\C-z\eo\C-z"'

	bind -m emacs-standard '"\ep": "\C-b\C-k \C-u`fzf-workspace-widget tmux`\e\C-e\er\C-m\C-y\C-h\e \C-y\ey\C-x\C-x\C-d"'
	bind -m vi-command '"\ep": "\C-z\ep\C-z"'
	bind -m vi-insert '"\ep": "\C-z\ep\C-z"'
fi

# ┏━━━━━━━━━━━━━━━━━━━━━━━
# ┃ starship & zoxide
# ┗━━━━━━━━━━━━━━━━━━━━━━━
command -v starship &>/dev/null && eval "$(starship init bash)"
command -v direnv &>/dev/null && eval "$(direnv hook bash)"
command -v zoxide &>/dev/null && eval "$(zoxide init bash)"

# ┏━━━━━━━━━━━━━━━━━━━━━━━
# ┃ GPG
# ┗━━━━━━━━━━━━━━━━━━━━━━━
gpg-connect-agent updatestartuptty /bye >/dev/null

# ┏━━━━━━━━━━━━━━━━━━━━━━━
# ┃ Utils
# ┗━━━━━━━━━━━━━━━━━━━━━━━
with_ghc() {
	local np
	np=$(ghcup --offline whereis -d ghc "$1" || { ghcup --cache install ghc "$1" && ghcup whereis -d ghc "$1"; })
	if [ -e "${np}" ]; then
		shift
		PATH="$np:$PATH" "$@"
	else
		echo >&2 "Cannot find or install GHC version $1"
		return 1
	fi
}

alert() {
	local ex="$?"
	notify-send "$(history | tail -n 1 | sed -e 's/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//')" "Done! Exit code: ${ex}"
}

library-menu() {
	fd -e pdf -e djvu '' Library/\[{Tech,Math}\]* | cut -c 9- | $MENU --dmenu -i -M fuzzy | xargs -d '\n' -I % "$READER" "Library/%"
}

workspace-menu() {
	local _dir dir has_session
	dir=$(fd -t d -d 1 . "$WORKSPACE" --format "{/}" | $MENU --dmenu -i -M fuzzy)
	if [[ "$dir" == "" ]]; then
		return 0
	fi
	_dir=${dir//[.]/_}
	tmux has-session -t "=$_dir" >/dev/null 2>/dev/null
	has_session=$?
	if [[ "$has_session" -ne 0 ]]; then
		tmux new-session -A -d -c "$WORKSPACE/$dir" -s "$_dir"
	fi
	echo "launch tmux attach-session -t $_dir" | kitty --session -
}

# ┏━━━━━━━━━━━━━━━━━━━━━━━
# ┃ Aliases
# ┗━━━━━━━━━━━━━━━━━━━━━━━
if command -v nvim &>/dev/null; then
	alias vim='nvim'
	alias n='nvim -S'
fi

if command -v exa &>/dev/null; then
	alias ls=exa
fi

if command -v btm &>/dev/null; then
	alias htop='btm -b'
fi

if [[ -n $WORKSPACE ]]; then
	alias cdw='cd $WORKSPACE'
fi

